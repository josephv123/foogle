# GPT-6 Luna on OpenRouter writes the results, pages and pictures.
OPENROUTER_API_KEY=sk-or-...
# Jev picks each site's layout. Without it, sites get a default layout.
# TYPESAFE_API_KEY=your-key
PORT=3000

# Spend limits (see "Limits" in README.md). Dollars; "off" disables one.
# RATE_LIMIT_BURST_USD=0.10
# RATE_LIMIT_USD_PER_HOUR=0.40
# DAILY_BUDGET_USD=5
# Behind a proxy, say how to find the visitor's IP: 1 (one hop of X-Forwarded-For) or a header name like fly-client-ip.
# TRUST_PROXY=1

# The fake browser bar across the top of every page; 0 turns it off.
# FOOGLE_BROWSER_BAR=0

# Development (see "Developing" in README.md): canned model and Jev output, no keys or network.
# FOOGLE_FAKE_LLM=1
# Or record real responses once, then replay them for free.
# FOOGLE_LLM_CACHE=record
