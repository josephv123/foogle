# Any OpenAI-compatible provider works (OpenRouter, OpenAI, Ollama, LM Studio, ...)
LLM_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model slugs in your provider's format
FOOGLE_RESULTS_MODEL=anthropic/claude-haiku-4.5
FOOGLE_PAGE_MODEL=anthropic/claude-sonnet-4.5

# Image generation
# "chat"   = image via chat completion with modalities:["image","text"] (OpenRouter style)
# "images" = OpenAI /v1/images/generations endpoint
# "svg"    = a text LLM draws vector illustrations (no image model needed)
# "ascii"  = a text LLM draws ASCII art (no image model needed)
FOOGLE_IMAGE_API=chat
# For chat/images modes: an image model slug. For svg/ascii: a text model (defaults to FOOGLE_PAGE_MODEL).
FOOGLE_IMAGE_MODEL=google/gemini-2.5-flash-image
# Parallel image generations (default 6)
# FOOGLE_IMAGE_CONCURRENCY=6

# Sampling temperature: results run hot for variety, pages neutral for reliable structure.
# Set a number, or "default" to not send the param at all.
# FOOGLE_TEMP_RESULTS=1.2
# FOOGLE_TEMP_PAGES=1.0

# Reasoning models think for seconds before the first visible byte.
# On OpenRouter, Foogle disables reasoning by default. Options:
#   off | low | medium | high | default (= never send the reasoning param; use for strict providers)
# FOOGLE_REASONING=off

PORT=3000
