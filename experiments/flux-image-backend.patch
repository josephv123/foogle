+// ---------- raster pictures (FOOGLE_IMAGE_BACKEND=flux, experimental) ----------
+// A diffusion model (FLUX.2 klein) paints these media far better than an SVG
+// can, photos above all. Media made of words (charts, diagrams, screenshots,
+// blueprints, maps) stay SVGs: their labels come out garbled when painted.
+export const RASTER_STYLES = new Set(["photo", "snapshot", "product", "render3d", "flat", "line", "woodcut", "watercolor", "painting", "isometric", "pixel", "meme", "poster", "collage", "sticker", "neon", "scan"]);
+
+// The prompt for a painted picture: the medium, the description, its light or
+// colour scheme, and the site's palette (FLUX.2 reads hex colours).
+export function rasterPrompt({ description, style, palette }) {
+  const st = STYLES[style];
+  const medium = st.brief.split(/(?<=[.:])\s/)[0].replace(/[:.]$/, "");
+  const scheme = !palette && st.free ? ` Colour scheme: ${pick(COLOR_SCHEMES, `${style} ${description}`)}.` : "";
+  const light = LIT.has(style) ? ` Light: ${pick(LIGHTS, description)}.` : "";
+  const colours = palette && !["photo", "snapshot", "scan"].includes(style) ? ` Colour palette: ${palette.fg} as the accent, ${palette.bg} for the background.` : "";
+  return `${st.label}. ${description}. Medium: ${medium}.${scheme}${light}${colours} ${st.text ? "Any words in it are short and legible." : "No text, no captions, no watermark."}`;
+}
+
 // What a news story's thumbnail can be.
 export const NEWS_STYLES = ["photo", "snapshot", "chart", "map", "scan", "screenshot", "diagram"];
 
