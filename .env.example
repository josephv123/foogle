# npm start defaults to GPT-6 Luna on OpenRouter, with Jev layout planning.
OPENROUTER_API_KEY=sk-or-...
# Optional: without this key, Luna also plans the page layout.
# TYPESAFE_API_KEY=your-key
FOOGLE_PRESET=luna
FOOGLE_PAGE_MODE=jev
PORT=3000

# Modes: jev | planned | single
# FOOGLE_JEV_MODEL=jev-latest
# FOOGLE_PAGE_SECTIONS=3
# FOOGLE_SECTION_MAX_TOKENS=1200
# FOOGLE_PAGE_MAX_TOKENS=8000
# FOOGLE_IMAGE_CONCURRENCY=6
# FOOGLE_TEMP_RESULTS=1.2
# FOOGLE_TEMP_PAGES=1.0
# FOOGLE_REASONING=off  # off | low | medium | high | default

# Custom provider: use --preset current (or FOOGLE_PRESET=current) to honor these.
# LLM_API_KEY=your-provider-key
# LLM_BASE_URL=https://openrouter.ai/api/v1
# FOOGLE_RESULTS_MODEL=openai/gpt-6-luna
# FOOGLE_PAGE_MODEL=openai/gpt-6-luna
# FOOGLE_IMAGE_API=ascii  # chat | images | svg | ascii
# FOOGLE_IMAGE_MODEL=openai/gpt-6-luna
